.context/

# Scratch space for command logs (e.g. `make check > tmp/check.log`)
tmp/

# mdreflow, built by `make md-reflow` and `make md-reflow-check`
.build/

# Python bytecode cache (generated by running the test suite)
__pycache__/
*.pyc

# Claude Code — local runtime artifacts (keep settings.json / commands / agents / skills / hooks tracked)
.claude/.credentials.json
.claude/scheduled_tasks.lock
.claude/shell-snapshots/
.claude/history.jsonl
.claude/todos/
.claude/tasks/
.claude/projects/
.claude/sessions/
.claude/session-env/
.claude/cache/
.claude/telemetry/
.claude/backups/
.claude/downloads/
# `make md-reflow` rewrites every Markdown file it walks, so this line is what
# keeps it out of other sessions' checkouts.
.claude/worktrees/
